local ChatScroll = Instance.new("ScrollingFrame")
ChatScroll.Size = UDim2.new(1, -20, 1, -100)
ChatScroll.Position = UDim2.new(0, 10, 0, 50)
ChatScroll.BackgroundTransparency = 1
ChatScroll.Parent = ChatFrame
Instance.new("UIListLayout", ChatScroll).VerticalAlignment = "Bottom"

local ChatInput = Instance.new("TextBox")
ChatInput.Size = UDim2.new(1, -20, 0, 35)
ChatInput.Position = UDim2.new(0, 10, 1, -45)
ChatInput.PlaceholderText = "Type message here..."
ChatInput.Text = ""
ChatInput.Parent = ChatFrame
Instance.new("UICorner", ChatInput)

local function addMsg(name, msg)
    local msgL = Instance.new("TextLabel")
    msgL.Size = UDim2.new(1, 0, 0, 20)
    msgL.Text = "["..name.."]: "..msg
    msgL.TextColor3 = Color3.fromRGB(100, 100, 100)
    msgL.Font = "Gotham"
    msgL.TextSize = 14
    msgL.TextXAlignment = "Left"
    msgL.BackgroundTransparency = 1
    msgL.Parent = ChatScroll
    ChatScroll.CanvasPosition = Vector2.new(0, ChatScroll.AbsoluteCanvasSize.Y)
end

ChatInput.FocusLost:Connect(function(enter)
    if enter and ChatInput.Text ~= "" then
        player:SetAttribute("DogChatMsg", ChatInput.Text)
        ChatInput.Text = ""
    end
end)

for _, p in pairs(Players:GetPlayers()) do
    p:GetAttributeChangedSignal("DogChatMsg"):Connect(function()
        addMsg(p.DisplayName, p:GetAttribute("DogChatMsg"))
    end)
end

-- --- 4. Leaderboard System ---
local RankScroll = Instance.new("ScrollingFrame")
RankScroll.Size = UDim2.new(1, -20, 1, -60)
RankScroll.Position = UDim2.new(0, 10, 0, 50)
RankScroll.BackgroundTransparency = 1
RankScroll.Parent = RankFrame
Instance.new("UIListLayout", RankScroll).Padding = UDim.new(0, 8)

local function updateRank()
    for _, v in pairs(RankScroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
    local users = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p:GetAttribute("UsingDogScript") then
            table.insert(users, {Name = p.DisplayName, Score = p:GetAttribute("DogClicks") or 0, Id = p.UserId})
        end
    end
    table.sort(users, function(a, b) return a.Score > b.Score end)
    for i, data in ipairs(users) do
        if i > 10 then break end
        local item = Instance.new("Frame")
        item.Size = UDim2.new(1, -5, 0, 45)
        item.BackgroundColor3 = Color3.fromRGB(252, 252, 252)
        item.Parent = RankScroll
        Instance.new("UICorner", item)
        
        local img = Instance.new("ImageLabel")
        img.Size = UDim2.new(0, 35, 0, 35)
        img.Position = UDim2.new(0, 5, 0.5, -17.5)
        img.Image = "https://www.roblox.com/headshot-thumbnail/image?userId="..data.Id.."&width=420&height=420&format=png"
        img.BackgroundTransparency = 1
        img.Parent = item
        Instance.new("UICorner", img).CornerRadius = UDim.new(1,0)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -50, 1, 0)
        label.Position = UDim2.new(0, 45, 0, 0)
        label.Text = i..". "..data.Name.." ("..data.Score..") 🐶"
        label.TextColor3 = Color3.fromRGB(100, 100, 100)
        label.TextXAlignment = "Left"
        label.BackgroundTransparency = 1
        label.Font = "GothamBold"
        label.Parent = item
    end
end

task.spawn(function()
    while wait(2) do
        if RankFrame.Visible then updateRank() end
    end
end)

