local player = game.Players.LocalPlayer
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")

-- Remove old UI if exists
if CoreGui:FindFirstChild("DogClickerPro") then CoreGui.DogClickerPro:Destroy() end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "DogClickerPro"
ScreenGui.Parent = CoreGui

-- --- Data Persistence System ---
local ClickCount = 0
local fileName = "DogClicker_EN_Data.txt"

local function saveStats()
    if writefile then writefile(fileName, tostring(ClickCount)) end
    player:SetAttribute("DogClicks", ClickCount)
end

local function loadStats()
    if isfile and isfile(fileName) then ClickCount = tonumber(readfile(fileName)) or 0 end
    player:SetAttribute("UsingDogScript", true)
    player:SetAttribute("DogClicks", ClickCount)
end
loadStats()

-- --- UI Window Factory ---
local function createWindow(titleText)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 280, 0, 350)
    frame.Position = UDim2.new(0.5, -140, 0.5, -175)
    frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    frame.Visible = false
    frame.Active = true
    frame.Draggable = true
    frame.Parent = ScreenGui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 20)
    Instance.new("UIStroke", frame).Color = Color3.fromRGB(240, 240, 240)

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -35, 0, 10)
    closeBtn.Text = "×"
    closeBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
    closeBtn.TextSize = 25
    closeBtn.BackgroundTransparency = 1
    closeBtn.Parent = frame
    closeBtn.MouseButton1Click:Connect(function() frame.Visible = false end)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 45)
    title.Text = titleText
    title.TextColor3 = Color3.fromRGB(100, 100, 100)
    title.Font = "GothamBold"
    title.TextSize = 16
    title.BackgroundTransparency = 1
    title.Parent = frame
    return frame
end

