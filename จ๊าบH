local G = game
local P = G.Players.LocalPlayer
local SG = Instance.new("ScreenGui", G:GetService("CoreGui"))
SG.Name = "JabHub_ModernUI"
SG.ResetOnSpawn = false

local function Create(cls, props)
    local i = Instance.new(cls)
    for k, v in pairs(props) do i[k] = v end
    return i
end

-- [[ แถบ Sidebar ด้านข้าง ]]
local M = Create("Frame", {Parent = SG, Size = UDim2.new(0, 550, 0, 350), Position = UDim2.new(0.5, -275, 0.5, -175), BackgroundColor3 = Color3.fromRGB(245, 248, 252), Draggable = true, Active = true})
Instance.new("UICorner", M).CornerRadius = UDim.new(0, 12)

local Sidebar = Create("Frame", {Parent = M, Size = UDim2.new(0, 140, 1, 0), BackgroundColor3 = Color3.fromRGB(235, 240, 245)})
Instance.new("UICorner", Sidebar).CornerRadius = UDim.new(0, 12)

-- Header ใน Sidebar
Create("TextLabel", {Parent = Sidebar, Size = UDim2.new(1, 0, 0, 50), Text = "จ๊าบHub - 99", Font = Enum.Font.GothamBold, TextSize = 14, BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(50, 50, 50)})

-- [[ Content Area (พื้นที่ด้านขวา) ]]
local Content = Create("Frame", {Parent = M, Position = UDim2.new(0, 150, 0, 10), Size = UDim2.new(1, -160, 1, -20), BackgroundTransparency = 1})

local Pgs = {}
local function AddPg(n)
    local p = Create("ScrollingFrame", {Parent = Content, Size = UDim2.new(1, 0, 1, 0), Visible = false, BackgroundTransparency = 1, CanvasSize = UDim2.new(0, 0, 1.5, 0), ScrollBarThickness = 0})
    Instance.new("UIListLayout", p).Padding = UDim.new(0, 8)
    Pgs[n] = p return p
end

local PgM = AddPg("Main")
local PgP = AddPg("Player")
local PgT = AddPg("Troll")
local PgS = AddPg("Settings")
PgM.Visible = true

-- [[ ฟังก์ชันสร้างปุ่มเมนูใน Sidebar ]]
local function Tab(n, icon)
    local b = Create("TextButton", {Parent = Sidebar, Size = UDim2.new(0.9, 0, 0, 35), Position = UDim2.new(0.05, 0, 0, 60 + (#Sidebar:GetChildren()-2)*40), Text = "  "..n, Font = Enum.Font.GothamMedium, TextSize = 13, BackgroundColor3 = Color3.fromRGB(220, 225, 230), TextXAlignment = Enum.TextXAlignment.Left})
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    b.MouseButton1Click:Connect(function() 
        for _,v in pairs(Pgs) do v.Visible = false end 
        Pgs[n].Visible = true 
    end)
end

Tab("Main")
Tab("Player")
Tab("Troll")
Tab("Settings")

-- [[ ฟังก์ชันสร้างปุ่มที่ดูเหมือนในรูป (ช่องยาวๆ โค้งๆ) ]]
local function ModernBtn(p, t, c)
    local f = Create("Frame", {Parent = p, Size = UDim2.new(1, 0, 0, 45), BackgroundColor3 = Color3.fromRGB(220, 230, 240)})
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 10)
    
    local b = Create("TextButton", {Parent = f, Size = UDim2.new(1, 0, 1, 0), Text = t, Font = Enum.Font.GothamBold, TextSize = 14, BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(80, 100, 120)})
    b.MouseButton1Click:Connect(c)
end

-- [[ ใส่ฟังก์ชันให้ปุ่ม ]]
ModernBtn(PgM, "Infinite Yield", function() loadstring(G:HttpGet('https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source'))() end)

-- ระบบวาร์ป (เหมือนเดิมแต่หน้าตาใหม่)
local Prof = Create("Frame", {Parent = PgP, Size = UDim2.new(1, 0, 0, 100), BackgroundColor3 = Color3.fromRGB(255, 255, 255)})
Instance.new("UICorner", Prof)
local P_Img = Create("ImageLabel", {Parent = Prof, Size = UDim2.new(0, 50, 0, 50), Position = UDim2.new(0, 10, 0, 10), Image = "rbxassetid://0"})
Instance.new("UICorner", P_Img).CornerRadius = UDim.new(1, 0)
local Inp = Create("TextBox", {Parent = Prof, Size = UDim2.new(0.6, 0, 0, 30), Position = UDim2.new(0, 70, 0, 20), PlaceholderText = "ชื่อผู้เล่น...", Text = "", Font = Enum.Font.Gotham})

Inp:GetPropertyChangedSignal("Text"):Connect(function()
    for _, v in pairs(G.Players:GetPlayers()) do
        if v.Name:lower():sub(1, #Inp.Text) == Inp.Text:lower() then
            P_Img.Image = G.Players:GetUserThumbnailAsync(v.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
            break
        end
    end
end)

ModernBtn(PgP, "วาร์ปไปหาคนนี้", function()
    for _, v in pairs(G.Players:GetPlayers()) do
        if v.Name:lower():find(Inp.Text:lower()) then P.Character.HumanoidRootPart.CFrame = v.Character.HumanoidRootPart.CFrame end
    end
end)

-- ปุ่ม Fling แยก (เหมือนเดิม)
local FS, Flg = nil, false
ModernBtn(PgT, "สร้างปุ่ม Fling แยก", function()
    if FS then FS:Destroy() FS=nil else
        FS = Create("TextButton", {Parent=SG, Size=UDim2.new(0,80,0,30), Position=UDim2.new(0.5,-40,0.8,0), Text="Fling: OFF", BackgroundColor3=Color3.new(1,0.2,0.2), Draggable=true, Font=Enum.Font.GothamBold, TextColor3=Color3.new(1,1,1)})
        Instance.new("UICorner", FS)
        FS.MouseButton1Click:Connect(function()
            Flg = not Flg
            FS.Text = Flg and "Fling: ON" or "Fling: OFF"
            FS.BackgroundColor3 = Flg and Color3.new(0.2,1,0.2) or Color3.new(1,0.2,0.2)
            local hrp = P.Character:FindFirstChild("HumanoidRootPart")
            if Flg then
                Create("BodyAngularVelocity", {Name="FF_Spin", Parent=hrp, MaxTorque=Vector3.new(0, 1e9, 0), AngularVelocity=Vector3.new(0, 99999, 0)})
                Create("BodyVelocity", {Name="FF_Move", Parent=hrp, MaxForce=Vector3.new(10, 0, 10), Velocity=Vector3.new(0,0,0)})
            else
                if hrp:FindFirstChild("FF_Spin") then hrp.FF_Spin:Destroy() end
                if hrp:FindFirstChild("FF_Move") then hrp.FF_Move:Destroy() end
            end
        end)
    end
end)

